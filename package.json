{
  "name": "regex-bench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Демонстрация влияния ReDoS на производительность: сравнение небезопасного и безопасного регулярных выражений с бенчмарком и изолированным прогоном.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "bench:node": "tsx bench-node/bench.ts",
    "bench:e2e": "playwright test",
    "bench:e2e:install": "playwright install --with-deps chromium",
    "bench:docker": "docker compose -f docker/docker-compose.yml up --build --abort-on-container-exit",
    "bench:collect": "tsx scripts/collect-runs.ts",
    "bench:all": "npm run bench:node && npm run bench:e2e && npm run bench:docker && npm run bench:collect",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chart.js": "^4.4.3",
    "recheck": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.20.5",
    "tinybench": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
